{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-design/scenarios.schema.json",
  "title": "Executable scenarios",
  "description": "One file, two consumers: the docs site animates it, and a scenario runner executes each step's `expect` and writes a proof file.",
  "type": "object",
  "required": [
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": [
        "ui",
        "mw",
        "svc",
        "store",
        "native",
        "warnb"
      ]
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "group",
        "cols",
        "rows",
        "nodes",
        "steps",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "description": "Navigation group, e.g. Walkthroughs, Flows, Failure paths, Services."
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "budgetMs": {
          "type": "number"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "col",
              "row",
              "kind",
              "component"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "col": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "$ref": "#/$defs/kind"
              },
              "component": {
                "enum": [
                  "actor",
                  "bus",
                  "store",
                  "router",
                  "io",
                  "family",
                  "pipe",
                  "supervisor",
                  "module",
                  "host",
                  "service",
                  "daemon",
                  "client",
                  "delivery",
                  "person",
                  "external"
                ],
                "description": "Which core component this box is an instance of."
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "nodes",
              "style"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "style": {
                "enum": [
                  "code",
                  "process",
                  "trust",
                  "machine",
                  "network"
                ]
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "label",
              "text",
              "expect",
              "proof"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "Narration. Ids such as D3, S-2, I-3 and [[section-id]] become links."
              },
              "expect": {
                "type": "string",
                "description": "The observable assertion the runner checks."
              },
              "proof": {
                "type": "object",
                "required": [
                  "kind",
                  "ref"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "contract",
                      "sim",
                      "invariant",
                      "bench",
                      "chaos",
                      "hil",
                      "review"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  }
                }
              },
              "ms": {
                "type": "number",
                "description": "Illustrative simulated time; the runner records the measured value."
              },
              "payload": {
                "type": "string"
              },
              "state": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "warn": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}