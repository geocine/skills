{
  "name": "@geocine/skills",
  "version": "0.1.6",
  "description": "CLI installer for Geocine agent skills.",
  "license": "MIT",
  "private": false,
  "files": [
    "bin",
    "README.md"
  ],
  "scripts": {
    "skills": "node src/skills.js",
    "build": "node scripts/bundle-cli.js",
    "test": "node --test tests/*.test.js",
    "prepack": "node scripts/manage-pack-readme.js prepack",
    "postpack": "node scripts/manage-pack-readme.js postpack",
    "prepublishOnly": "npm run build && npm test"
  },
  "bin": {
